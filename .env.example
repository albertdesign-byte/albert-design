# Resend — required to deliver the contact form to Gmail.
# Create an account at https://resend.com with hola.albertdesign@gmail.com
# and paste the API key here.
RESEND_API_KEY=

# Inbox that receives every submission.
CONTACT_TO_EMAIL=hola.albertdesign@gmail.com

# Sender. Resend's test address works while the Resend account is that Gmail.
# For production, verify a domain in Resend and switch to e.g.
# Albert Design <hola@your-domain.com>
CONTACT_FROM_EMAIL="Albert Design <onboarding@resend.dev>"
